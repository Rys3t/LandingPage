# 複製為 .env 後填入(Cloudinary Console → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# 每個作品類型使用一個根資料夾;其子資料夾名稱會成為「系列」
GALLERY_PORTFOLIO_ROOT_FOLDER=portfolio
GALLERY_STREET_ROOT_FOLDER=street

# 伺服器目錄快取秒數 (30–3600)，前端每 60 秒重新讀取
GALLERY_CACHE_SECONDS=60
